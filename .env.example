# LLM — provider-agnostic. Escolha o provedor e instale o extra correspondente:
#   gemini      -> pip install -e ".[llm-gemini]"     (Google AI Studio)
#   groq        -> pip install -e ".[llm-groq]"
#   openai      -> pip install -e ".[llm-openai]"
#   together    -> pip install -e ".[llm-together]"
#   openrouter  -> pip install -e ".[llm-openai]"      (endpoint compatível)
#   none/fake   -> sem LLM (roteamento semântico + heurística apenas)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.0

# Preencha apenas a chave do provedor escolhido.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Observabilidade (Parte 4) — opcional
# pip install -e ".[observability]"
# Sem chaves, a API segue normalmente (tracer no-op).
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# Câmbio
FX_API_URL=https://economia.awesomeapi.com.br/json/last/{pair}
FX_MOCK=true

# Paths
DATA_DIR=data
MODELS_DIR=models
CHECKPOINTER_DB=data/sessions.sqlite

# ML — roteamento semântico e segurança
ROUTER_CONFIDENCE_THRESHOLD=0.75
SAFETY_ENABLED=true
SAFETY_THRESHOLD=0.80

# API (Parte 3)
API_BASE_URL=http://localhost:8000

