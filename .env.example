# LLM (usado a partir da Parte 2)
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# Observabilidade (Parte 4)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Câmbio
FX_API_URL=https://economia.awesomeapi.com.br/json/last/{pair}
FX_MOCK=true

# Paths
DATA_DIR=data
MODELS_DIR=models
CHECKPOINTER_DB=data/sessions.sqlite

# ML — roteamento semântico e segurança
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
ROUTER_CONFIDENCE_THRESHOLD=0.75
SAFETY_ENABLED=true
SAFETY_THRESHOLD=0.80

# API (Parte 3)
API_BASE_URL=http://localhost:8000
